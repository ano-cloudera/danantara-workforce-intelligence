# Global / shared
ENVIRONMENT=poc
LOG_LEVEL=INFO
AUTH_MODE=cai
DEMO_USER=demo.hr@danantara.local

# Cloudera AI Application runtime
# CDSW_APP_PORT is injected by CAI; do not assign a fixed deployment port.
CDSW_APP_PORT=
PORT=
APP_BIND_HOST=127.0.0.1

# Gemini
GEMINI_BACKEND=gemini_api
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
GEMINI_TEMPERATURE=0.2
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Frontend
BACKEND_BASE_URL=
CDV_DASHBOARD_URL=

# Backend runtime
ORCHESTRATOR_MODE=crewai
DATA_MODE=demo
INGEST_MODE=backend
SQLITE_PATH=./data/workforce-app/app_state.db
UPLOAD_DIR=./data/workforce-app/uploads
CORS_ORIGINS=*

# Qdrant
QDRANT_MODE=optional
QDRANT_BASE_URL=
QDRANT_API_KEY=change-me
QDRANT_TIMEOUT_SECONDS=5
# Deprecated compatibility input; the backend now uses Qdrant's REST API directly.
QDRANT_CHECK_COMPATIBILITY=false
QDRANT_TRUST_ENV=false
QDRANT_NIFI_COLLECTION=nifi_documents
QDRANT_CANDIDATE_COLLECTION=workforce_candidates
QDRANT_POLICY_COLLECTION=workforce_policies
QDRANT_TOP_K=6

# CDW / Impala (required when DATA_MODE=impala)
IMPALA_HOST=
IMPALA_JDBC_URL=
IMPALA_PORT=443
IMPALA_DATABASE=danantara
IMPALA_AUTH_MECHANISM=PLAIN
IMPALA_USER=
IMPALA_PASSWORD=
IMPALA_USE_SSL=true
IMPALA_TRANSPORT_MODE=http
IMPALA_HTTP_PATH=cliservice
IMPALA_CANDIDATE_TABLE=danantara.v_candidates_api
IMPALA_POSITION_TABLE=danantara.curated_job_positions
IMPALA_POLICY_DOCUMENT_TABLE=danantara.v_policy_documents_api
# Governed policy downloads in CAI use IDBroker/Ranger through hadoop fs.
POLICY_SOURCE_ACCESS_MODE=local

# CAI Workbench CV ingestion Job
# Use the platform workload identity for S3; do not store AWS access keys here.
AWS_REGION=ap-southeast-3
# datalake uses CAI Hadoop/S3A with IDBroker and Ranger; boto3 is the local fallback.
S3_ACCESS_MODE=boto3
HADOOP_FS_COMMAND=hadoop fs
S3_COMMAND_TIMEOUT_SECONDS=120
S3_CV_INPUT_URI=s3://example-bucket/data/cv-collect/
S3_CV_PROCESSED_URI=s3://example-bucket/data/cv-processed/
S3_CV_FAILED_URI=s3://example-bucket/data/cv-failed/
CV_JOB_MAX_OBJECTS=20
CV_JOB_DRY_RUN=false
CV_JOB_INIT_SCHEMA=false
ICEBERG_CATALOG=hive
ICEBERG_DATABASE=danantara
ICEBERG_WAREHOUSE_URI=
ICEBERG_CANDIDATE_MASTER_TABLE=danantara.candidate_master
ICEBERG_CANDIDATE_SKILLS_TABLE=danantara.candidate_skills
ICEBERG_CANDIDATE_EXPERIENCE_TABLE=danantara.candidate_experience
ICEBERG_INGESTION_AUDIT_TABLE=danantara.cv_ingestion_audit

# CAI Workbench policy ingestion Job (PoC fallback; NiFi/CDE remain production targets)
S3_POLICY_INPUT_URI=s3://example-bucket/data/policy-collect/
S3_POLICY_PROCESSED_URI=s3://example-bucket/data/policy-processed/
S3_POLICY_REVIEW_URI=s3://example-bucket/data/policy-review/
S3_POLICY_FAILED_URI=s3://example-bucket/data/policy-failed/
POLICY_JOB_MAX_OBJECTS=20
POLICY_JOB_MAX_FILE_BYTES=52428800
POLICY_JOB_MAX_CHUNKS=500
POLICY_JOB_DRY_RUN=true
POLICY_JOB_INIT_SCHEMA=false
ICEBERG_POLICY_DOCUMENT_TABLE=danantara.policy_documents
ICEBERG_POLICY_AUDIT_TABLE=danantara.policy_ingestion_audit

# NiFi (required when INGEST_MODE=nifi)
NIFI_INGEST_URL=
NIFI_BEARER_TOKEN=

# Guardrails
GUARDRAILS_MODE=builtin
GUARDRAILS_MAX_INPUT_CHARS=12000
GUARDRAILS_REQUIRE_POLICY_CITATIONS=true

# Observability gateway
OBSERVABILITY_BASE_URL=
OBSERVABILITY_API_KEY=change-me
OBSERVABILITY_STORE_PATH=./data/observability.db

# Optional Langfuse forwarding from observability app
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=poc

# Qdrant application runtime
QDRANT_VERSION=1.19.0
QDRANT_STORAGE_PATH=./data/qdrant-storage
QDRANT_DOWNLOAD_URL=
