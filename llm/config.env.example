# Default configuration for 4x NVIDIA A10G (24 GB each)
# 2 GPUs -> Qwen3-14B (tensor parallel), 2 GPUs -> BGE-M3 embedding (2 replicas)
LLM_MODEL_ID=Qwen/Qwen3-14B
LLM_MODEL_DIR=./models/qwen3-14b
EMBED_MODEL_ID=BAAI/bge-m3
EMBED_MODEL_DIR=./models/bge-m3

LLM_TENSOR_PARALLEL_SIZE=2
LLM_GPU_MEMORY_UTILIZATION=0.90
EMBED_NUM_REPLICAS=2
EMBED_GPU_PER_REPLICA=1.0
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=16
DTYPE=bfloat16

# Optional. Qwen3 and BGE-M3 are public, so a token is not required.
# HF_TOKEN=hf_xxx
