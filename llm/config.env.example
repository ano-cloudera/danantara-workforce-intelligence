# Default configuration for 2x NVIDIA A10G (24 GB each)
# 1 GPU -> Qwen3-14B-AWQ (INT4, no tensor parallel), 1 GPU -> BGE-M3 embedding (no replication)
LLM_MODEL_ID=Qwen/Qwen3-14B-AWQ
LLM_MODEL_DIR=./models/qwen3-14b-awq
EMBED_MODEL_ID=BAAI/bge-m3
EMBED_MODEL_DIR=./models/bge-m3

LLM_TENSOR_PARALLEL_SIZE=1
LLM_QUANTIZATION=awq_marlin
LLM_GPU_MEMORY_UTILIZATION=0.90
EMBED_NUM_REPLICAS=1
EMBED_GPU_PER_REPLICA=1.0
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=16
DTYPE=auto

# Optional. Qwen3-14B-AWQ and BGE-M3 are public, so a token is not required.
# HF_TOKEN=hf_xxx
